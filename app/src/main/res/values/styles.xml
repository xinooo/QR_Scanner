<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.QRScanner.BottomNavigation.Item" parent="Widget.Material3.Button.TextButton">
        <item name="android:gravity">center</item>
        <item name="android:checkable">true</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nav_item_color</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/nav_item_background</item>
        <item name="cornerRadius">28dp</item>
        <item name="elevation">0dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">2dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/nav_item_color</item>
        <item name="rippleColor">@color/bottom_nav_ripple</item>
    </style>

</resources>
